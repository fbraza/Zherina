---
import logoUrl from "../../assets/company_logo_white.svg?url";
---

<footer class="mx-4 mb-4 min-h-[240px] rounded-xl bg-surface md:mx-9 lg:mb-10 lg:rounded-3xl">
    <div class="flex min-h-[240px] flex-col justify-between gap-12 p-8 md:p-12 lg:flex-row lg:items-center lg:gap-8">
        <a href="#" class="flex items-center gap-4 text-text no-underline" aria-label="Zhirena — top">
            <span class="relative block h-[52px] w-[52px] overflow-hidden" aria-hidden="true">
                <img
                    src={logoUrl}
                    alt=""
                    class="absolute w-[120px] max-w-none -translate-x-[26px] -translate-y-[34px]"
                />
            </span>
            <span class="font-sans text-[48px] leading-none font-medium tracking-[0.08em] uppercase">ZHIRENA</span>
        </a>

        <div class="flex flex-col gap-3.5 font-sans text-[14px] leading-[14px] text-text lg:text-right">
            <p>
                <a href="https://www.linkedin.com/in/julie-chesn%C3%A9/" target="_blank" rel="noreferrer" class="hover:text-accent">LinkedIn</a>
            </p>
            <p>@ZHIRENA 2026. All rights reserved.</p>
        </div>
    </div>
</footer>
