---
import linkedinLogoUrl from "../../assets/linkedin-logo-muted.png?url";
import pubmedLogoUrl from "../../assets/pubmed-logo-muted.png?url";

const expertise = [
    "Immunology",
    "Obesity",
    "Metabolic Diseases",
    "MASH",
    "Cancer",
    "Immuno-Oncology",
    "Inflammation",
    "Respiratory Diseases",
    "Kidney Disease",
    "Small Molecules",
    "Antibodies",
    "RNA Therapeutics",
    "Oligonucleotides",
    "siRNA",
    "Drug Discovery",
    "Preclinical Pharmacology",
    "Translational Research",
    "Mechanism of Action",
    "Target Validation",
    "Experimental Design",
    "In Vivo Models",
    "In Vitro Models",
    "Human Translational Models",
    "Biomarkers",
    "Data Integration",
    "Scientific Strategy",
    "CRO Management",
    "Immune Profiling",
    "Flow Cytometry",
    "Gene Expression",
];

const initialExpertise = expertise.slice(0, 7);
---

<section class="relative isolate overflow-hidden px-4 py-12 md:px-9 md:py-16 lg:min-h-[calc(100svh-72px)] lg:pt-32 lg:pb-20">
    <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 90% 82% at 48% 36%, #171615 0%, #0c0c0c 54%, #020202 100%);"
    ></div>
    <div
        data-hero-texture
        class="pointer-events-none absolute inset-0 opacity-[0.05]"
        aria-hidden="true"
        style="background-image: radial-gradient(circle, rgba(255,255,255,.6) 0, rgba(255,255,255,.6) .7px, transparent .95px), repeating-linear-gradient(rgba(255,255,255,.18) 0 1px, transparent 1px 4px); background-size: 5px 5px, 100% 4px;"
    ></div>
    <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(transparent 0%, transparent 38%, rgba(0,0,0,.55) 100%);"
    ></div>

    <div
        class="relative z-10 mx-auto grid w-full max-w-[1920px] grid-cols-1 gap-10 lg:grid-cols-[minmax(0,48fr)_minmax(0,52fr)] lg:items-center lg:gap-16"
    >
        <div>
            <h1
                class="max-w-[11ch] font-sans text-[clamp(3rem,5vw,4.5rem)] leading-none tracking-[-0.04em] text-text"
            >
                Turn Science <span class="block">Into Strategy</span>
            </h1>

            <div class="mt-6 max-w-[58ch]">
                <p
                    class="font-mono text-[16px] leading-[1.5] tracking-[-0.01em] text-muted"
                >
                    I love to partner with founders to accelerate the path from
                    bench to market. I will dive into your research and
                    pre-clinical strategy to build investor-ready narratives. I
                    am passionate about science and want it to reach patients.
                </p>
                <p class="mt-4 font-mono text-[16px] leading-[1.5] tracking-[0.01em] text-muted">
                    Let's build together.
                </p>
            </div>
        </div>

        <aside
            class="relative grid h-[320px] grid-cols-[43%_57%] overflow-hidden rounded-[4px] border border-transparent bg-surface sm:h-auto sm:min-h-[340px] sm:grid-cols-[48%_52%] lg:aspect-[5/4] lg:min-h-0 lg:grid-cols-[56%_44%]"
            aria-label="Julie Chesne consulting expertise"
        >
            <div class="relative min-h-0 overflow-hidden bg-accent">
                <img
                    src="/julie-chesne.jpg"
                    alt="Portrait of Julie Chesne"
                    class="absolute top-px right-0 bottom-px left-px h-[calc(100%-2px)] w-[calc(100%-1px)] object-cover object-[78%_50%] lg:object-[82%_50%]"
                    width="2400"
                    height="1600"
                    loading="eager"
                    fetchpriority="high"
                />
            </div>

            <div class="flex min-h-0 min-w-0 flex-col overflow-hidden bg-black p-4 sm:p-6 lg:p-7">
                <div class="flex items-start gap-3 font-mono text-[10px] leading-[1.35] tracking-[0.05em] text-soft uppercase sm:text-[11px]">
                    <span class="mt-[3px] size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>
                        <span class="block">Dr. Julie Chesné</span>
                        <span class="block">Principal Scientist</span>
                        <span class="block">R&amp;D Consultant</span>
                    </span>
                </div>

                <ul
                    class="expertise-horizon"
                    aria-label="Areas of expertise"
                    data-expertise-horizon
                    data-expertise={JSON.stringify(expertise)}
                >
                    {initialExpertise.map((label, index) => (
                        <li style={`--word-top: ${10 + index * (80 / 6)}%`}>
                            <span>{label}</span>
                        </li>
                    ))}
                </ul>

                <div class="flex items-center justify-end gap-3">
                    <a
                        href="https://pubmed.ncbi.nlm.nih.gov/?term=chesne+J&amp;sort=date"
                        target="_blank"
                        rel="noreferrer"
                        class="pubmed-logo w-[60px] sm:w-[70px]"
                        aria-label="View Julie Chesné publications on PubMed"
                    >
                        <img
                            src={pubmedLogoUrl}
                            alt=""
                            class="pubmed-logo__image"
                            width="2089"
                            height="753"
                            loading="eager"
                        />
                    </a>

                    <a
                        href="https://www.linkedin.com/in/julie-chesn%C3%A9/"
                        target="_blank"
                        rel="noreferrer"
                        class="linkedin-logo"
                        aria-label="View Julie Chesné on LinkedIn"
                    >
                        <img
                            src={linkedinLogoUrl}
                            alt=""
                            class="linkedin-logo__image"
                            width="1762"
                            height="1733"
                            loading="eager"
                        />
                    </a>
                </div>
            </div>

            <span
                class="pointer-events-none absolute inset-0 z-10 rounded-[4px] border border-accent"
                aria-hidden="true"
            ></span>
        </aside>
    </div>
</section>

<script>
    const horizon = document.querySelector<HTMLElement>("[data-expertise-horizon]");

    if (horizon) {
        const words = JSON.parse(horizon.dataset.expertise ?? "[]") as string[];
        const slots = Array.from(horizon.querySelectorAll<HTMLElement>("li"));
        const mobileQuery = window.matchMedia("(max-width: 639px)");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let pool: string[] = [];

        const nextWord = () => {
            const visible = slots
                .filter((slot) => !slot.hidden)
                .map((slot) => slot.textContent?.trim());

            if (!pool.length) {
                pool = [...words].sort(() => Math.random() - 0.5);
            }

            const index = pool.findIndex((word) => !visible.includes(word));
            return pool.splice(index < 0 ? 0 : index, 1)[0];
        };

        const launch = (slot: HTMLElement, index: number, count: number, initial = false) => {
            const mobile = mobileQuery.matches;
            const label = nextWord();
            const preferredSize = 10 + Math.random() * 4;
            const availableWidth = mobile ? 118 : 205;
            const fittedSize = availableWidth / (label.length * 0.62);

            slot.hidden = false;
            slot.querySelector("span")!.textContent = label;
            slot.style.setProperty("--word-top", `${10 + index * (80 / Math.max(1, count - 1))}%`);
            slot.style.setProperty("--word-size", `${Math.max(mobile ? 8 : 9, Math.min(preferredSize, fittedSize))}px`);
            slot.style.setProperty("--word-opacity", `${0.65 + Math.random() * 0.25}`);
            slot.style.setProperty("--word-duration", `${10 + Math.random() * 5}s`);
            slot.style.setProperty("--word-travel", mobile ? "12px" : "24px");
            slot.style.animationDelay = initial ? `${index * -0.7}s` : "0s";
            slot.classList.remove("is-moving");
            void slot.offsetWidth;
            slot.classList.add("is-moving");
        };

        const setup = () => {
            const count = mobileQuery.matches ? 5 : 7;
            slots.forEach((slot, index) => {
                slot.classList.remove("is-moving");
                slot.hidden = index >= count;
                if (index < count) launch(slot, index, count, true);
            });
        };

        slots.forEach((slot, index) => {
            slot.addEventListener("animationend", () => {
                if (!slot.hidden && !reducedMotion.matches) {
                    launch(slot, index, mobileQuery.matches ? 5 : 7);
                }
            });
        });

        setup();
        mobileQuery.addEventListener("change", setup);
    }
</script>

<style>
    .pubmed-logo {
        position: relative;
        isolation: isolate;
        aspect-ratio: 2089 / 753;
    }

    .pubmed-logo__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .pubmed-logo:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 4px;
    }

    .linkedin-logo {
        position: relative;
        display: block;
        width: 19.2px;
        height: 17.6px;
    }

    .linkedin-logo__image {
        position: absolute;
        top: 50%;
        right: 0;
        width: 10.24px;
        height: 10.24px;
        object-fit: contain;
        transform: translateY(-56%);
    }

    .linkedin-logo:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 2px;
    }

    .expertise-horizon {
        position: relative;
        flex: 1;
        min-height: 0;
        margin: 0.8rem 0;
        padding: 0;
        overflow: hidden;
        list-style: none;
    }

    .expertise-horizon li {
        position: absolute;
        top: var(--word-top);
        left: 3%;
        color: var(--color-silver);
        font-family: var(--font-mono);
        font-size: var(--word-size, 12px);
        line-height: 1;
        white-space: nowrap;
        opacity: var(--word-opacity, 0.72);
        will-change: transform, opacity;
    }

    .expertise-horizon span {
        display: block;
        transition:
            color 240ms ease,
            transform 320ms cubic-bezier(0.2, 0.75, 0.25, 1);
    }

    .expertise-horizon li:hover {
        z-index: 1;
        animation-play-state: paused;
    }

    .expertise-horizon li:hover span {
        color: var(--color-accent);
        transform: scale(1.24);
    }

    .expertise-horizon li.is-moving {
        animation: horizon-pass var(--word-duration) linear forwards;
    }

    @keyframes horizon-pass {
        0% {
            transform: translateX(0) scale(0.9);
            opacity: 0;
        }

        18%,
        80% {
            opacity: var(--word-opacity);
        }

        100% {
            transform: translateX(var(--word-travel)) scale(1.04);
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .expertise-horizon li.is-moving {
            animation: none;
        }
    }

    @media (min-width: 640px) {
        .linkedin-logo {
            height: 20px;
        }

        .linkedin-logo__image {
            width: 11.52px;
            height: 11.52px;
        }
    }
</style>
