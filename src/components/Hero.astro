---
import linkedinLogoUrl from "../../assets/linkedin-logo.png?url";
import pubmedOrangeUrl from "../../assets/pubmed-variant-orange-m.png?url";
import pubmedWhiteUrl from "../../assets/pubmed-variant-white-m.png?url";
---

<section class="relative isolate overflow-hidden px-4 py-12 md:px-9 md:py-16 lg:min-h-[calc(100svh-72px)] lg:pt-32 lg:pb-20">
    <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 90% 82% at 48% 36%, #171615 0%, #0c0c0c 54%, #020202 100%);"
    ></div>
    <div
        data-hero-texture
        class="pointer-events-none absolute inset-0 opacity-[0.05]"
        aria-hidden="true"
        style="background-image: radial-gradient(circle, rgba(255,255,255,.6) 0, rgba(255,255,255,.6) .7px, transparent .95px), repeating-linear-gradient(rgba(255,255,255,.18) 0 1px, transparent 1px 4px); background-size: 5px 5px, 100% 4px;"
    ></div>
    <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(transparent 0%, transparent 38%, rgba(0,0,0,.55) 100%);"
    ></div>

    <div
        class="relative z-10 mx-auto grid w-full max-w-[1920px] grid-cols-1 gap-10 lg:grid-cols-[minmax(0,48fr)_minmax(0,52fr)] lg:items-center lg:gap-16"
    >
        <div>
            <h1
                class="max-w-[11ch] font-sans text-[clamp(3rem,5vw,4.5rem)] leading-none tracking-[-0.04em] text-text"
            >
                Turn Science <span class="block">Into Strategy</span>
            </h1>

            <div class="mt-6 max-w-[58ch]">
                <p
                    class="font-mono text-[16px] leading-[1.5] tracking-[-0.01em] text-muted"
                >
                    I love to partner with founders to accelerate the path from
                    bench to market. I will dive into your research and
                    pre-clinical strategy to build investor-ready narratives. I
                    am passionate about science and want it to reach patients.
                </p>
                <p class="mt-4 font-mono text-[16px] leading-[1.5] tracking-[0.01em] text-muted">
                    Let's build together.
                </p>
            </div>
        </div>

        <aside
            class="grid min-h-[272px] grid-cols-[43%_57%] overflow-hidden rounded-[4px] border border-accent bg-surface sm:min-h-[340px] sm:grid-cols-[48%_52%] lg:aspect-[5/4] lg:min-h-0 lg:grid-cols-[56%_44%]"
            aria-label="Julie Chesne consulting expertise"
        >
            <div class="relative min-h-0 overflow-hidden bg-raised">
                <img
                    src="/julie-chesne.jpg"
                    alt="Portrait of Julie Chesne"
                    class="absolute inset-0 h-full w-full object-cover object-[78%_50%] lg:object-[82%_50%]"
                    width="2400"
                    height="1600"
                    loading="eager"
                    fetchpriority="high"
                />
            </div>

            <div class="flex min-w-0 flex-col bg-black p-4 sm:p-6 lg:p-7">
                <div class="flex items-start gap-3 font-mono text-[10px] leading-[1.35] tracking-[0.05em] text-soft uppercase sm:text-[11px]">
                    <span class="mt-[3px] size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>
                        <span class="block">Dr. Julie Chesné</span>
                        <span class="block">Principal Scientist</span>
                        <span class="block">R&amp;D Consultant</span>
                    </span>
                </div>

                <div class="mt-auto ml-[17px] flex items-center">
                    <a
                        href="https://pubmed.ncbi.nlm.nih.gov/?term=chesne+J&amp;sort=date"
                        target="_blank"
                        rel="noreferrer"
                        class="pubmed-logo w-[60px] sm:w-[70px]"
                        aria-label="View Julie Chesné publications on PubMed"
                    >
                        <img
                            src={pubmedWhiteUrl}
                            alt=""
                            class="pubmed-logo__image pubmed-logo__image--white"
                            width="2089"
                            height="753"
                            loading="eager"
                        />
                        <img
                            src={pubmedOrangeUrl}
                            alt=""
                            class="pubmed-logo__image pubmed-logo__image--orange"
                            width="2089"
                            height="753"
                            loading="eager"
                        />
                    </a>

                    <a
                        href="https://www.linkedin.com/in/julie-chesn%C3%A9/"
                        target="_blank"
                        rel="noreferrer"
                        class="linkedin-logo"
                        aria-label="View Julie Chesné on LinkedIn"
                    >
                        <img
                            src={linkedinLogoUrl}
                            alt=""
                            class="linkedin-logo__image linkedin-logo__image--base"
                            width="1762"
                            height="1733"
                            loading="eager"
                        />
                        <img
                            src={linkedinLogoUrl}
                            alt=""
                            class="linkedin-logo__image linkedin-logo__image--orange-i"
                            width="1762"
                            height="1733"
                            loading="eager"
                        />
                        <img
                            src={linkedinLogoUrl}
                            alt=""
                            class="linkedin-logo__image linkedin-logo__image--white-n"
                            width="1762"
                            height="1733"
                            loading="eager"
                        />
                    </a>
                </div>
            </div>
        </aside>
    </div>
</section>

<style>
    .pubmed-logo {
        position: relative;
        isolation: isolate;
        aspect-ratio: 2089 / 753;
    }

    .pubmed-logo__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: contrast(1.12);
        mix-blend-mode: screen;
    }

    .pubmed-logo__image--white {
        opacity: 1;
    }

    .pubmed-logo__image--orange {
        opacity: 0;
    }

    .pubmed-logo:hover .pubmed-logo__image--white,
    .pubmed-logo:focus-visible .pubmed-logo__image--white {
        opacity: 0;
    }

    .pubmed-logo:hover .pubmed-logo__image--orange,
    .pubmed-logo:focus-visible .pubmed-logo__image--orange {
        opacity: 1;
    }

    .pubmed-logo:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 4px;
    }

    .linkedin-logo {
        position: relative;
        display: block;
        width: 24px;
        height: 22px;
        margin-left: 4px;
    }

    .linkedin-logo__image {
        position: absolute;
        top: 50%;
        left: 0;
        width: 12.8px;
        height: 12.8px;
        object-fit: contain;
        transform: translateY(-56%);
        transition: opacity 150ms ease;
    }

    .linkedin-logo__image--base {
        opacity: 1;
        filter: brightness(0) invert(55%);
    }

    .linkedin-logo__image--orange-i {
        opacity: 0;
        filter: brightness(0) saturate(100%) invert(54%) sepia(87%) saturate(3348%) hue-rotate(343deg) brightness(99%) contrast(89%);
        clip-path: inset(0 68% 0 0);
    }

    .linkedin-logo__image--white-n {
        opacity: 0;
        filter: brightness(0) invert(93%);
        clip-path: inset(0 0 0 27%);
    }

    .linkedin-logo:hover .linkedin-logo__image--base,
    .linkedin-logo:focus-visible .linkedin-logo__image--base {
        opacity: 0;
    }

    .linkedin-logo:hover .linkedin-logo__image--orange-i,
    .linkedin-logo:hover .linkedin-logo__image--white-n,
    .linkedin-logo:focus-visible .linkedin-logo__image--orange-i,
    .linkedin-logo:focus-visible .linkedin-logo__image--white-n {
        opacity: 1;
    }

    .linkedin-logo:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 2px;
    }

    @media (min-width: 640px) {
        .linkedin-logo {
            height: 25px;
        }

        .linkedin-logo__image {
            width: 14.4px;
            height: 14.4px;
        }
    }
</style>
