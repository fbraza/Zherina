---
// Replace this record only after the client has approved the quote and attribution.
const testimonials = [
    {
        quote: "Approved client testimonial copy pending.",
        name: "Client name pending approval",
        role: "Role and organization pending approval",
    },
];

const hasMultipleTestimonials = testimonials.length > 1;
---

<section
    class="testimonials mx-auto my-20 grid w-full max-w-[1920px] grid-cols-4 gap-x-4 px-4 md:px-9 lg:mt-20 lg:mb-30 lg:grid-cols-12 lg:gap-x-6"
    aria-labelledby="testimonials-title"
    data-testimonials
>
    <span class="col-span-full mb-8 border-t border-rule lg:mb-0" aria-hidden="true"></span>

    <h2
        id="testimonials-title"
        class="col-span-full inline-flex items-center gap-3 font-mono text-[12px] leading-none tracking-[-0.015rem] text-muted uppercase lg:col-span-3 lg:pt-4"
    >
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        Testimonials
    </h2>

    <div class="testimonial-card col-span-full mt-8 min-h-[360px] rounded-[6px] border border-rule bg-surface px-6 pt-6 pb-7 lg:col-span-7 lg:col-start-6 lg:mt-4 lg:flex lg:min-h-[390px] lg:gap-8 xl:col-span-6 xl:col-start-7">
        <div class="testimonial-controls lg:pt-1">
            {hasMultipleTestimonials ? (
                <div class="testimonial-tabs" role="tablist" aria-label="Select a testimonial">
                    {testimonials.map((_, index) => (
                        <button
                            class="testimonial-tab"
                            type="button"
                            role="tab"
                            aria-label={`Show testimonial ${index + 1}`}
                            aria-selected={index === 0 ? "true" : "false"}
                            tabindex={index === 0 ? 0 : -1}
                            data-testimonial-tab={index}
                        >
                            <span class="testimonial-tab__track">
                                <span class="testimonial-tab__progress"></span>
                            </span>
                        </button>
                    ))}
                </div>
            ) : (
                <span class="testimonial-marker" aria-hidden="true">
                    <span></span>
                </span>
            )}
        </div>

        <div class="testimonial-copy" aria-live={hasMultipleTestimonials ? "polite" : "off"}>
            {testimonials.map((testimonial, index) => (
                <article
                    data-testimonial-slide={index}
                    data-active={index === 0 ? "true" : "false"}
                    aria-hidden={index === 0 ? "false" : "true"}
                >
                    <blockquote>
                        <p>“{testimonial.quote}”</p>
                    </blockquote>

                    <footer>
                        <span class="attribution-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <rect x="1" y="1" width="22" height="22" rx="3"></rect>
                                <path d="M5 18 18 5M9 18l9-9M13 18l5-5M17 18h1v-1"></path>
                            </svg>
                        </span>
                        <div>
                            <cite>{testimonial.name}</cite>
                            <p>{testimonial.role}</p>
                        </div>
                    </footer>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .testimonial-card {
        overflow: hidden;
    }

    .testimonial-controls {
        flex: 0 0 auto;
    }

    .testimonial-marker,
    .testimonial-tabs {
        display: flex;
        width: fit-content;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem;
        border: 1px solid var(--color-rule-strong);
        border-radius: 999px;
    }

    .testimonial-marker {
        height: 1rem;
    }

    .testimonial-marker::before {
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 999px;
        content: "";
        background: var(--color-accent);
    }

    .testimonial-marker span {
        width: 1.75rem;
        height: 0.375rem;
        border-radius: 999px;
        background: var(--color-muted);
    }

    .testimonial-tab {
        display: grid;
        padding: 0;
        border: 0;
        color: inherit;
        background: transparent;
        cursor: pointer;
        place-items: center;
    }

    .testimonial-tab:focus-visible {
        outline: 1px solid var(--color-text);
        outline-offset: 4px;
    }

    .testimonial-tab__track {
        position: relative;
        display: block;
        overflow: hidden;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--color-rule-strong);
        transition: width 300ms ease;
    }

    .testimonial-tab[aria-selected="true"] .testimonial-tab__track {
        width: 2rem;
    }

    .testimonial-tab__progress {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0;
        background: var(--color-accent);
    }

    .testimonial-tab[aria-selected="true"] .testimonial-tab__progress {
        animation: testimonial-progress 8s linear forwards;
    }

    .testimonials[data-paused="true"] .testimonial-tab__progress {
        animation-play-state: paused;
    }

    .testimonial-copy {
        display: grid;
        min-width: 0;
        min-height: 17rem;
        margin-top: 2rem;
    }

    .testimonial-copy article {
        display: flex;
        grid-area: 1 / 1;
        flex-direction: column;
        justify-content: space-between;
        min-width: 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.75rem);
        transition:
            opacity 350ms ease,
            transform 350ms ease,
            visibility 350ms;
    }

    .testimonial-copy article[data-active="true"] {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    blockquote,
    blockquote p {
        margin: 0;
    }

    blockquote p {
        max-width: 22ch;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: clamp(1.75rem, 7vw, 2.25rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.045em;
    }

    footer {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-top: 3rem;
    }

    .attribution-mark {
        display: block;
        flex: 0 0 1.5rem;
        width: 1.5rem;
        height: 1.5rem;
        color: var(--color-silver);
    }

    .attribution-mark svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: square;
    }

    cite {
        display: block;
        color: var(--color-silver);
        font-family: var(--font-sans);
        font-size: 1rem;
        font-style: normal;
        line-height: 1.25;
    }

    footer p {
        margin: 0.375rem 0 0;
        color: var(--color-muted);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.4;
    }

    @keyframes testimonial-progress {
        to {
            width: 100%;
        }
    }

    @media (min-width: 1024px) {
        .testimonial-marker {
            width: 1rem;
            height: auto;
            flex-direction: column;
        }

        .testimonial-marker span {
            width: 0.375rem;
            height: 1.75rem;
        }

        .testimonial-tabs {
            flex-direction: column;
        }

        .testimonial-tab__track {
            transition: height 300ms ease;
        }

        .testimonial-tab[aria-selected="true"] .testimonial-tab__track {
            width: 0.5rem;
            height: 2rem;
        }

        .testimonial-tab__progress {
            inset: 0 0 auto;
            width: 100%;
            height: 0;
        }

        .testimonial-tab[aria-selected="true"] .testimonial-tab__progress {
            animation-name: testimonial-progress-desktop;
        }

        .testimonial-copy {
            flex: 1;
            min-height: 0;
            margin-top: 0;
        }

        @keyframes testimonial-progress-desktop {
            to {
                height: 100%;
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .testimonial-tab__progress {
            animation: none !important;
        }

        .testimonial-copy article {
            transition: none;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>("[data-testimonials]").forEach((section) => {
        const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-testimonial-tab]"));
        const slides = Array.from(section.querySelectorAll<HTMLElement>("[data-testimonial-slide]"));

        if (tabs.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        let activeIndex = 0;

        const show = (nextIndex: number) => {
            activeIndex = nextIndex;

            tabs.forEach((tab, index) => {
                const active = index === activeIndex;
                tab.setAttribute("aria-selected", String(active));
                tab.tabIndex = active ? 0 : -1;
            });

            slides.forEach((slide, index) => {
                const active = index === activeIndex;
                slide.dataset.active = String(active);
                slide.setAttribute("aria-hidden", String(!active));
            });
        };

        tabs.forEach((tab, index) => tab.addEventListener("click", () => show(index)));

        section.addEventListener("animationend", (event) => {
            if ((event.target as HTMLElement).classList.contains("testimonial-tab__progress")) {
                show((activeIndex + 1) % tabs.length);
            }
        });

        section.addEventListener("mouseenter", () => section.dataset.paused = "true");
        section.addEventListener("mouseleave", () => section.dataset.paused = "false");
        section.addEventListener("focusin", () => section.dataset.paused = "true");
        section.addEventListener("focusout", (event) => {
            if (!section.contains((event as FocusEvent).relatedTarget as Node | null)) {
                section.dataset.paused = "false";
            }
        });
    });
</script>
