---
const stages = [
    {
        number: "01",
        title: "Scientific evidence",
        items: ["Mechanism of action", "Model relevance", "Biomarkers"],
        critical: false,
    },
    {
        number: "02",
        title: "Critical decisions",
        items: ["Evidence gaps", "Experiment priorities", "Go / no-go criteria"],
        critical: true,
    },
    {
        number: "03",
        title: "First-in-human readiness",
        items: ["Translational package", "Investor narrative", "Development roadmap"],
        critical: false,
    },
];
---

<section
    id="services"
    class="mx-auto my-20 w-full max-w-[1920px] bg-canvas px-4 md:px-9 lg:mt-20 lg:mb-30"
    aria-labelledby="research-strategy-title"
>
    <h2
        id="research-strategy-title"
        class="max-w-[760px] font-sans text-[34px] leading-[1.12] tracking-[-0.045rem] text-text lg:max-w-none lg:whitespace-nowrap lg:text-[44px] lg:tracking-[-0.07rem]"
    >
        Defining your research strategy
    </h2>

    <figure class="decision-map mt-10 lg:mt-14" aria-labelledby="decision-map-title">
        <figcaption class="decision-map__header">
            <span class="decision-map__eyebrow">Program decision map</span>
            <span class="decision-map__code" aria-hidden="true">E → FIH</span>
            <h3 id="decision-map-title">From evidence to first-in-human readiness</h3>
            <p>A structured view of evidence, decisions, and translational planning.</p>
        </figcaption>

        <ol class="decision-map__stages">
            {stages.map((stage) => (
                <li class:list={["decision-map__stage", { "decision-map__stage--critical": stage.critical }]}>
                    <div class="decision-map__stage-heading">
                        <span class="decision-map__number">{stage.number}</span>
                        <h4>{stage.title}</h4>
                    </div>
                    <ul>
                        {stage.items.map((item) => <li>{item}</li>)}
                    </ul>
                </li>
            ))}
        </ol>

        <div class="decision-map__outcome" aria-label="Planning focus: first-in-human readiness">
            <span>Planning focus</span>
            <strong>First-in-human readiness</strong>
            <span aria-hidden="true">→</span>
        </div>
    </figure>
</section>

<style>
    .decision-map {
        position: relative;
        margin-right: 0;
        margin-left: 0;
        border-top: 1px solid var(--color-rule-strong);
        border-bottom: 1px solid var(--color-rule-strong);
        background: rgba(2, 2, 2, 0.34);
    }

    .decision-map::before {
        position: absolute;
        top: -2px;
        left: 0;
        width: 4.5rem;
        height: 3px;
        content: "";
        background: var(--color-accent);
    }

    .decision-map__header {
        display: grid;
        grid-template-columns: 1fr auto;
        padding: 1.25rem 0 1.5rem;
        border-bottom: 1px solid var(--color-rule);
    }

    .decision-map__eyebrow,
    .decision-map__code,
    .decision-map__number,
    .decision-map__outcome span {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        line-height: 1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .decision-map__eyebrow {
        color: var(--color-accent);
    }

    .decision-map__code {
        color: var(--color-muted);
    }

    .decision-map__header h3 {
        grid-column: 1 / -1;
        margin: 1.75rem 0 0;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .decision-map__header p {
        grid-column: 1 / -1;
        margin: 0.625rem 0 0;
        color: var(--color-muted);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.5;
    }

    .decision-map__stages {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .decision-map__stage {
        position: relative;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--color-rule);
    }

    .decision-map__stage-heading {
        display: grid;
        grid-template-columns: 2rem 1fr;
        align-items: baseline;
        gap: 0.75rem;
    }

    .decision-map__number {
        color: var(--color-muted);
    }

    .decision-map__stage--critical .decision-map__number {
        color: var(--color-accent);
    }

    .decision-map__stage h4 {
        margin: 0;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .decision-map__stage ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem 1rem;
        margin: 0.875rem 0 0 2.75rem;
        padding: 0;
        color: var(--color-soft);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        line-height: 1.4;
        list-style: none;
    }

    .decision-map__stage ul > li {
        position: relative;
        padding-left: 0.625rem;
    }

    .decision-map__stage ul > li::before {
        position: absolute;
        top: 0.4rem;
        left: 0;
        width: 3px;
        height: 3px;
        content: "";
        background: var(--color-rule-strong);
    }

    .decision-map__stage--critical ul > li::before {
        background: var(--color-accent);
    }

    .decision-map__outcome {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 0;
    }

    .decision-map__outcome span {
        color: var(--color-accent);
    }

    .decision-map__outcome strong {
        color: var(--color-silver);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 400;
        line-height: 1.3;
    }

    @media (min-width: 768px) {
        .decision-map {
            padding: 0 1.5rem;
            border-right: 1px solid var(--color-rule);
            border-left: 1px solid var(--color-rule);
        }

        .decision-map::before {
            left: 1.5rem;
        }

        .decision-map__stages {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .decision-map__stage {
            min-height: clamp(20rem, 24vw, 26rem);
            padding: 2rem;
            border-bottom: 0;
            border-left: 1px solid var(--color-rule);
        }

        .decision-map__stage:first-child {
            padding-left: 0;
            border-left: 0;
        }

        .decision-map__stage:last-child {
            padding-right: 0;
        }

        .decision-map__stage:not(:last-child)::after {
            position: absolute;
            z-index: 1;
            top: 3.1rem;
            right: -0.35rem;
            width: 0.65rem;
            color: var(--color-accent);
            background: #0a0909;
            content: "→";
            font-family: var(--font-mono);
            font-size: 0.75rem;
            line-height: 1;
            text-align: center;
        }

        .decision-map__stage-heading {
            display: block;
        }

        .decision-map__stage h4 {
            min-height: 2.5rem;
            margin-top: 0.75rem;
        }

        .decision-map__stage ul {
            display: block;
            margin: 1.25rem 0 0;
        }

        .decision-map__stage ul > li {
            padding: 0.75rem 0 0.75rem 0.75rem;
            border-top: 1px solid rgba(61, 58, 57, 0.65);
        }

        .decision-map__stage ul > li::before {
            top: 1.1rem;
        }
    }
</style>
