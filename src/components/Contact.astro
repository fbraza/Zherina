---
const fields = [
    { id: "first-name", label: "First Name", type: "text", autocomplete: "given-name" },
    { id: "last-name", label: "Last Name", type: "text", autocomplete: "family-name" },
    { id: "company", label: "Company", type: "text", autocomplete: "organization" },
    { id: "work-email", label: "Work Email", type: "email", autocomplete: "email" },
];
---

<section id="contact" class="relative mx-auto my-20 grid w-full max-w-[1920px] scroll-mt-24 grid-cols-1 gap-y-8 px-4 md:scroll-mt-30 md:px-9 lg:mt-20 lg:mb-30 lg:grid-cols-12 lg:gap-x-6">
    <span class="pointer-events-none absolute top-0 right-4 left-4 border-t border-rule md:right-9 md:left-9" aria-hidden="true"></span>
    <div class="lg:col-span-5 lg:pt-4">
        <div class="mb-4 inline-flex items-center gap-3 font-mono text-[12px] leading-[12px] tracking-[-0.015rem] text-muted uppercase">
            <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
            WHY ZHIRENA
        </div>
        <h2 class="font-sans text-[30px] leading-[1.05] tracking-[-0.075rem] text-text lg:-ml-1 lg:text-[44px] lg:tracking-[-0.11rem]">
            <span class="block">Clear thinking.</span>
            <span class="block">Rigorous science.</span>
            <span class="block">Meaningful progress.</span>
        </h2>
        <p class="mt-6 font-mono text-[16px] leading-[1.5] tracking-[-0.01rem] text-muted">
            Zhirena is a created name inspired by two eastern philosophical ideas: zhi (智), meaning wisdom and discernment, and ren (仁), meaning humanity and benevolence. It represents an approach to R&D grounded in scientific rigor, clear decision-making, and the pursuit of meaningful impact on human health.
        </p>
        <p class="mt-4 font-mono text-[16px] leading-[1.5] tracking-[-0.01rem] text-muted">
            In practice Zhirena provides more than high-level scientific advice. Clients work directly with an experienced consultant who is deeply engaged in the detail of each programme by combining rigorous analysis, clear communication, and evidence-based guidance. The aim is to bring clarity to complex R&D questions in order to support your scientific decision-making.
        </p>
    </div>

    <div class="rounded-[6px] border border-rule bg-surface p-4 md:p-8 lg:col-span-6 lg:col-start-7 lg:mt-8">
        <form>
            <div class="mb-6 flex items-center text-xl text-text lg:mb-10 lg:text-2xl">
                <span class="mr-3 size-2 rounded-full bg-accent" aria-hidden="true"></span>
                Contact us
            </div>

            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                {fields.map(({ id, label, type, autocomplete }) => (
                    <div>
                        <label for={id} class="mb-2 block font-mono text-[12px] leading-[12px] tracking-[-0.015rem] text-text uppercase">
                            {label}*
                        </label>
                        <input
                            id={id}
                            name={id}
                            type={type}
                            autocomplete={autocomplete}
                            placeholder={label}
                            required
                            class="block h-9 w-full rounded-[3px] border border-rule bg-transparent px-4 font-sans text-[12px] text-text placeholder:text-muted transition-colors focus:border-accent focus:outline-none"
                        />
                    </div>
                ))}

                <div class="lg:col-span-2">
                    <label for="referral" class="mb-2 block font-mono text-[12px] leading-[12px] tracking-[-0.015rem] text-text uppercase">
                        How did you find us*
                    </label>
                    <select
                        id="referral"
                        name="referral"
                        required
                        class="block h-9 w-full rounded-[3px] border border-rule bg-transparent px-4 font-sans text-[12px] text-text invalid:text-muted transition-colors focus:border-accent focus:outline-none"
                    >
                        <option value="" selected disabled>Select one...</option>
                        <option>Search engine</option>
                        <option>Referral</option>
                        <option>Social media</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="lg:col-span-2">
                    <label for="message" class="mb-2 block font-mono text-[12px] leading-[12px] tracking-[-0.015rem] text-text uppercase">
                        How can we help?
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="3"
                        placeholder="Tell us about your use case, timeline, or any questions..."
                        class="block h-[72px] w-full resize-none rounded-[3px] border border-rule bg-transparent px-4 py-2 font-sans text-[12px] leading-[18px] text-text placeholder:text-muted transition-colors focus:border-accent focus:outline-none"
                    ></textarea>
                </div>
            </div>

            <button type="submit" class="mt-8 inline-flex h-[31px] items-center rounded-[3px] bg-rule-strong px-[14px] text-canvas transition-colors hover:bg-text">
                <span class="flex items-center gap-2 uppercase">
                    <span class="font-mono text-[14px] leading-[14px] tracking-[-0.0175rem]">SUBMIT</span>
                    <span class="inline-block w-[18px] text-center" aria-hidden="true">→</span>
                </span>
            </button>
        </form>
    </div>
</section>
