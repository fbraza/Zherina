---
const links = [
  { href: "#track-record", label: "Track Record" },
  { href: "#publications", label: "Publications" },
];
---

<header class="sticky top-0 z-50 border-b border-cool-gray/40 bg-chalk-gray">
  <nav class="mx-auto flex max-w-[1680px] items-center justify-between px-6 py-5 md:px-12">
    <a
      href="#"
      class="text-body leading-body tracking-heading text-carbon-black no-underline font-medium"
      aria-label="Julie Chesne — top"
    >
      Julie Chesne
    </a>

    <ul class="group flex items-center gap-10">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-link text-body-sm leading-body-sm text-[#4C4947] no-underline transition-colors duration-150 group-hover:text-[#8D8B8A] hover:text-[#ED722E]"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="ml-4">
        <a
          href="#contact"
          class="
            border border-cool-gray
            text-body-sm leading-body-sm text-[#4C4947]
            no-underline
            px-3 py-1
            rounded-[var(--radius-buttons)]
            transition-all duration-150
            hover:bg-carbon-black hover:border-carbon-black hover:text-chalk-gray
          "
        >
          Book a call
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background-color: #ed722e;
    transition: width 200ms ease-out;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>
