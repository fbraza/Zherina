---
import logoUrl from "../../assets/company_logo_white.svg?url";

const links = [
    { href: "#track-record", label: "Track Record" },
    { href: "#publications", label: "Publications" },
];
---

<header class="sticky top-0 z-50 bg-canvas">
    <nav
        class="mx-auto flex h-[64px] max-w-[1920px] items-center justify-between px-4 md:h-[72px] md:px-9"
        aria-label="Main navigation"
    >
        <a
            href="#"
            class="flex items-center gap-2.5 text-text no-underline"
            aria-label="Koios — top"
        >
            <span class="relative block h-7 w-7 overflow-hidden" aria-hidden="true">
                <img
                    src={logoUrl}
                    alt=""
                    class="absolute w-16 max-w-none -translate-x-[14px] -translate-y-[18px]"
                />
            </span>
            <span class="text-[22px] font-medium leading-none tracking-[0.08em] uppercase md:text-[26px]">
                Koios
            </span>
        </a>

        <ul class="flex items-center gap-5 md:gap-8">
            {links.map(({ href, label }) => (
                <li class="hidden sm:list-item">
                    <a
                        href={href}
                        class="font-mono text-[11px] leading-none tracking-[0.05em] text-text no-underline uppercase transition-colors duration-150 hover:text-accent md:text-[12px]"
                    >
                        {label}
                    </a>
                </li>
            ))}
            <li class="ml-1 md:ml-2">
                <a
                    href="#contact"
                    class="inline-flex min-h-8 items-center border border-transparent bg-text-strong px-3 font-mono text-[11px] leading-none tracking-[0.05em] text-canvas no-underline uppercase transition-colors duration-150 hover:bg-text md:px-4 md:text-[12px]"
                >
                    Book a call
                </a>
            </li>
        </ul>
    </nav>
</header>
