---
import logoUrl from "../../assets/company_logo_white.svg?url";
---

<header class="sticky top-0 z-50 bg-canvas">
    <nav
        class="relative mx-auto grid h-[124px] max-w-[1920px] grid-cols-[1fr_auto] grid-rows-[60px_64px] items-center px-4 md:flex md:h-[72px] md:justify-between md:px-9"
        aria-label="Main navigation"
    >
        <a
            href="#"
            class="flex min-h-11 items-center gap-2.5 text-text no-underline md:min-h-0"
            aria-label="Zhirena — top"
        >
            <span class="relative block h-7 w-7 overflow-hidden" aria-hidden="true">
                <img
                    src={logoUrl}
                    alt=""
                    class="absolute w-16 max-w-none -translate-x-[14px] -translate-y-[18px]"
                />
            </span>
            <span class="text-[22px] font-medium leading-none tracking-[0.08em] uppercase md:text-[26px]">
                Zhirena
            </span>
        </a>

        <ul class="col-span-2 row-start-2 flex items-center gap-2 border-t border-rule py-[10px] md:ml-auto md:gap-3 md:border-0 md:py-0">
            <li class="flex-1 md:flex-none">
                <a
                    href="#services"
                    class="inline-flex min-h-11 w-full items-center justify-center border border-rule px-3 font-mono text-[11px] leading-none tracking-[0.05em] text-muted no-underline uppercase transition-colors duration-150 hover:border-rule-strong hover:text-text md:min-h-8 md:w-auto md:text-[12px]"
                >
                    Key Services
                </a>
            </li>
            <li class="flex-1 md:flex-none">
                <a
                    href="#how-i-work"
                    class="inline-flex min-h-11 w-full items-center justify-center border border-rule px-3 font-mono text-[11px] leading-none tracking-[0.05em] text-muted no-underline uppercase transition-colors duration-150 hover:border-rule-strong hover:text-text md:min-h-8 md:w-auto md:text-[12px]"
                >
                    How I work
                </a>
            </li>
        </ul>

        <a
            href="#contact-form"
            class="col-start-2 row-start-1 inline-flex min-h-9 items-center justify-self-end border border-transparent bg-text-strong px-3 font-mono text-[11px] leading-none tracking-[0.05em] text-canvas no-underline uppercase transition-colors duration-150 hover:bg-text md:hidden"
        >
            Contact me
        </a>

        <a
            href="#contact"
            class="hidden items-center border border-transparent bg-text-strong px-4 font-mono text-[12px] leading-none tracking-[0.05em] text-canvas no-underline uppercase transition-colors duration-150 hover:bg-text md:ml-2 md:inline-flex md:min-h-8"
        >
            Contact me
        </a>
    </nav>
</header>
