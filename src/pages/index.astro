---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import CompaniesCarousel from "../components/CompaniesCarousel.astro";
import KeyServices from "../components/KeyServices.astro";
import ValueProposition from "../components/ValueProposition.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

export const prerender = true;
---

<Base title="Zhirena — Biotech Consulting">
  <Nav />
  <main>
    <Hero />
    <CompaniesCarousel />
    <div class="mx-auto my-20 w-full max-w-[1920px] px-4 md:px-9 lg:my-30">
      <div class="bg-surface px-4 pt-6 pb-8 md:px-6 lg:px-9 lg:pt-10 lg:pb-20">
        <KeyServices />
        <ValueProposition />
      </div>
    </div>
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</Base>
